# =============================================================================
# DressApp Eyes Fine-Tuning & Model Publishing Environment Variables
# =============================================================================

# --- Hugging Face Credentials ---
# Access token with WRITE permissions to publish checkpoints to Yoram-Jacobs/dressapp-eyes-gguf
EYES_HF_TOKEN=your_huggingface_write_token_here
# Alternative aliases supported by the pipeline:
# HF_TOKEN=your_huggingface_write_token_here
# HF_WRITE=your_huggingface_write_token_here

# Base vision-language model identifier
BASE_MODEL=google/gemma-4-e4b-it

# --- RunPod Serverless GPU Credentials ---
# Generated from RunPod dashboard: Settings > API Keys
RUNPOD_API_KEY=your_runpod_api_key_here
# Alternative alias supported:
# RUNPOD_KEY=your_runpod_api_key_here

# --- Production VPS Staging (SSH) ---
# SSH Private Key for automatic staging to root@178.105.144.142
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
VPS_HOST=178.105.144.142
